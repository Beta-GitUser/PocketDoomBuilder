; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PocketDoomBuilder"
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

PDB="*res://pd_core_autoload.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

[layer_names]

2d_physics/layer_1="World"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
textures/vram_compression/import_etc2_astc=true

[physics]

common/physics_engine="Jolt Physics"

[android]

# Storage permissions so the app can use /storage/emulated/0/ as the base
# directory (avoids SAF file-picker issues). MANAGE_EXTERNAL_STORAGE is the
# Android 11+ broad-access permission; READ/WRITE_EXTERNAL_STORAGE cover
# older versions.
permissions=PackedStringArray("MANAGE_EXTERNAL_STORAGE", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE")
