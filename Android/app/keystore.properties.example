# Copy to app/keystore.properties (or export the same values as environment
# variables) to sign builds with a key of your own instead of the throwaway
# debug key. app/keystore.properties is git-ignored: NEVER commit it, and never
# commit the .jks/.keystore file either.
storeFile=pocketdoombuilder.jks
storePassword=change-me
keyAlias=pocketdoombuilder
keyPassword=change-me
